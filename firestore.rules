rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /students/{id} { allow read, create: if true; allow update, delete: if request.auth != null; }
    match /meta/{id} { allow read, write: if true; }
    match /{col}/{id} { allow read: if true; allow write: if request.auth != null; }
  }
}
